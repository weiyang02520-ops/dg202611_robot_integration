# Runtime entry points must keep Unix line endings in Windows-built archives.
*.sh text eol=lf
*.py text eol=lf

# vision_perception libexec wrappers have no extension; CRLF shebangs become
# `python3\r` and fail with exit 127 on Linux. Force LF for the whole scripts/.
# Package-local copy: src/vision_perception/.gitattributes (isolated two-package sync).
src/vision_perception/scripts/** text eol=lf
src/vision_perception/.gitattributes text eol=lf

# Integrity lists are consumed by sha256sum on the robot.
*.sha256 text eol=lf

# This evidence note was hashed with LF; preserve those bytes in the archive.
evidence/uwb/20260905/LONG_RUN_TERMINAL_RECORD.md text eol=lf
